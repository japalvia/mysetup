#!/usr/bin/env python3
"""i3status wrapper that injects an AirPods battery block into the bar.

Runs i3status as a child, relays its i3bar JSON stream, and splices in one extra
block built from `airpods-battery`. Use it as i3's status_command:

    bar {
        status_command ~/bin/i3status-airpods
    }

IMPORTANT: ~/.config/i3status/config must set `output_format = "i3bar"` inside
its `general { }` block. i3status' default `auto` picks its output format from
the *parent process name*; with this wrapper in between, the parent is python3
rather than i3bar, so i3status would otherwise fall back to plain text and there
would be nothing to parse.

The fetch never runs on the relay path: a background thread polls
`airpods-battery` and the pump only ever reads the last known value, so a slow
or hanging Bluetooth read can't stall the clock.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import threading
import time

# i3status' own default colours, so the block matches the rest of the bar.
COLOR_DEGRADED = "#FFFF00"
COLOR_BAD = "#FF0000"

# Exit codes of airpods-battery.
RC_OK = 0
RC_ERROR = 1          # not connected / no AAP device -> hide the block
RC_NO_READING = 2     # connected but no frame in time -> keep the last value

NOTIFY_REARM_MARGIN = 5  # percent above --critical before the warning re-arms


class State:
    """Last known reading, shared between the fetcher and the pump."""

    def __init__(self) -> None:
        self._lock = threading.Lock()
        self._reading: dict | None = None

    def get(self) -> dict | None:
        with self._lock:
            return self._reading

    def set(self, reading: dict | None) -> None:
        with self._lock:
            self._reading = reading


# --------------------------------------------------------------------------- #
# fetching
# --------------------------------------------------------------------------- #

def fetch(tool: str, timeout: float) -> tuple[int, dict | None]:
    """Run airpods-battery once. Returns (exit code, reading or None)."""
    try:
        proc = subprocess.run(
            [tool, "--json", "--timeout", str(timeout)],
            capture_output=True,
            text=True,
            timeout=timeout + 5,
        )
    except (OSError, subprocess.SubprocessError):
        return RC_ERROR, None

    if proc.returncode != RC_OK:
        return proc.returncode, None

    try:
        reading = json.loads(proc.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        return RC_ERROR, None
    return RC_OK, reading if isinstance(reading, dict) and reading else None


def pick_component(reading: dict) -> tuple[int, bool] | None:
    """Reduce a reading to (level, charging). AirPods Max report one component."""
    for name in ("headset", "left", "right", "case"):
        state = reading.get(name)
        if isinstance(state, dict) and isinstance(state.get("level"), int):
            return state["level"], bool(state.get("charging"))
    return None


def fetcher(state: State, args: argparse.Namespace) -> None:
    """Poll forever. Cadence follows what happened last time, per the exit code."""
    warned = False
    while True:
        rc, reading = fetch(args.tool, args.timeout)

        if rc == RC_OK:
            state.set(reading)
            delay = args.interval
            picked = pick_component(reading or {})
            if picked:
                warned = maybe_notify(picked[0], picked[1], warned, args)
        elif rc == RC_NO_READING:
            # Connected, just nothing pushed in time. Keep showing the old value.
            delay = args.retry_interval
        else:
            state.set(None)
            warned = False
            delay = args.retry_interval

        time.sleep(delay)


def maybe_notify(level: int, charging: bool, warned: bool, args: argparse.Namespace) -> bool:
    """Fire one desktop notification per discharge cycle. Returns the new flag."""
    if charging or level >= args.critical + NOTIFY_REARM_MARGIN:
        return False  # re-arm
    if warned or level >= args.critical:
        return warned
    try:
        subprocess.run(
            ["notify-send", "-u", "critical", "-a", "airpods",
             "AirPods battery low", f"{level}%"],
            check=False, capture_output=True, timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        pass
    return True


# --------------------------------------------------------------------------- #
# rendering
# --------------------------------------------------------------------------- #

def build_block(reading: dict, args: argparse.Namespace) -> dict | None:
    picked = pick_component(reading)
    if not picked:
        return None
    level, charging = picked

    block = {
        "name": "airpods",
        "instance": "headset",
        "markup": "none",
        "full_text": f"{'⚡' if charging else ''}🎧 {level}%",
    }
    if not charging:
        if level < args.critical:
            block["color"] = COLOR_BAD
        elif level < args.low:
            block["color"] = COLOR_DEGRADED
    return block


def splice(blocks: list, block: dict) -> list:
    """Insert the block just before i3status' own battery block."""
    for index, existing in enumerate(blocks):
        if isinstance(existing, dict) and existing.get("name") == "battery":
            return blocks[:index] + [block] + blocks[index:]
    return blocks + [block]


# --------------------------------------------------------------------------- #
# the i3bar protocol pump
# --------------------------------------------------------------------------- #

def pump(proc: subprocess.Popen, state: State, args: argparse.Namespace) -> int:
    out = sys.stdout
    assert proc.stdout is not None

    for lineno, raw in enumerate(proc.stdout):
        line = raw.rstrip("\n")

        # Header ({"version":1}) and the opening bracket of the infinite array.
        if lineno < 2:
            out.write(line + "\n")
            out.flush()
            continue

        prefix, payload = ("", line)
        if payload.startswith(","):
            prefix, payload = ",", payload[1:]

        try:
            blocks = json.loads(payload)
            if not isinstance(blocks, list):
                raise ValueError("not a block array")
        except ValueError:
            # Never let a surprise from i3status take the bar down.
            out.write(line + "\n")
            out.flush()
            continue

        reading = state.get()
        if reading:
            block = build_block(reading, args)
            if block:
                blocks = splice(blocks, block)

        out.write(prefix + json.dumps(blocks, ensure_ascii=False) + "\n")
        out.flush()

    return proc.wait()


# --------------------------------------------------------------------------- #

def default_tool() -> str:
    """airpods-battery sitting next to this script (following any symlink)."""
    return os.path.join(os.path.dirname(os.path.realpath(__file__)), "airpods-battery")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Inject an AirPods battery block into i3status' output.",
    )
    parser.add_argument("--interval", type=float, default=60.0, metavar="SEC",
                        help="refresh period while connected (default: 60)")
    parser.add_argument("--retry-interval", type=float, default=15.0, metavar="SEC",
                        help="re-probe period while disconnected (default: 15)")
    parser.add_argument("--timeout", type=float, default=4.0, metavar="SEC",
                        help="timeout passed to airpods-battery (default: 4)")
    parser.add_argument("--low", type=int, default=20, metavar="PCT",
                        help="colour the block yellow below this (default: 20)")
    parser.add_argument("--critical", type=int, default=10, metavar="PCT",
                        help="colour red and notify below this (default: 10)")
    parser.add_argument("--tool", default=default_tool(), metavar="PATH",
                        help="path to airpods-battery (default: next to this script)")
    parser.add_argument("--i3status-config", metavar="PATH",
                        help="passed to i3status as -c")
    args = parser.parse_args(argv)

    command = ["i3status"]
    if args.i3status_config:
        command += ["-c", args.i3status_config]

    try:
        proc = subprocess.Popen(command, stdout=subprocess.PIPE, text=True)
    except OSError as exc:
        print(f"i3status-airpods: cannot start i3status: {exc}", file=sys.stderr)
        return 1

    state = State()
    threading.Thread(target=fetcher, args=(state, args), daemon=True).start()

    try:
        return pump(proc, state, args)
    except (BrokenPipeError, KeyboardInterrupt):
        proc.terminate()
        return 0


if __name__ == "__main__":
    sys.exit(main())
